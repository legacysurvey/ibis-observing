;   qsouth = bmap LT 0 AND decmap LT 6.0 AND decmap GT -15 $
;    AND ((bmap LT -27 AND ramap GT 270) OR (bmap LT -47 AND ramap LT 90))
   qsouth = bmap LT 0 AND decmap LT 3.0 AND decmap GT -18 $
    AND ((bmap LT -27 AND ramap GT 270) OR (bmap LT -47 AND ramap LT 90))


